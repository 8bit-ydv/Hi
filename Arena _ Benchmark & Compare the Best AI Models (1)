}
.target{
  position:relative;width:clamp(120px,27vw,208px);aspect-ratio:100/92;
  will-change:transform;transform-origin:50% 60%
}
.heart__glow{
  position:absolute;left:50%;top:52%;width:230%;aspect-ratio:1;
