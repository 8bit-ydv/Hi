  const ptr = { x: 0, y: 0, tx: 0, ty: 0 };
  let clockT = 0, lastFrame = 0;

  const lerp = (a, b, t) =&gt; a + (b - a) * t;
  const clamp01 = v =&gt; Math.max(0, Math.min(1, v));
  const smooth = t =&gt; t * t * (3 - 2 * t);
  const randFloat = (a, b) =&gt; a + Math.random() * (b - a);
  const gauss = () =&gt; (Math.random() + Math.random() + Math.random() - 1.5) * 0.816;

  /* ---------- tiny OBJ parser (positions + fan faces) ---------- */
  function parseOBJ(text) {
    const vs = [], idx = [], lines = text.split("\n");
    for (let i = 0; i &lt; lines.length; i++) {
      const ln = lines[i].trim();
      if (ln.startsWith("v ")) {
        const p = ln.split(/\s+/);
        vs.push(+p[1], +p[2], +p[3]);
      } else if (ln.startsWith("f ")) {
        const p = ln.split(/\s+/).slice(1).map(tok =&gt; parseInt(tok.split("/")[0], 10) - 1);
        for (let k = 1; k &lt; p.length - 1; k++) idx.push(p[0], p[k], p[k + 1]);
      }
