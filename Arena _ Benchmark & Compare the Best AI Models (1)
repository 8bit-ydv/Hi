2"><svg width="16" height="16" stroke-width="1.5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" color="currentColor" class="shrink-0 text-text-secondary" aria-hidden="true"><path d="M13.5 6L10 18.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path><path d="M6.5 8.5L3 12L6.5 15.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path><path d="M17.5 8.5L21 12L17.5 15.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path></svg><span class="min-w-0 flex-1 truncate text-sm font-normal text-text-primary">_new_corridor.js</span><span class="bg-surface-secondary text-text-tertiary shrink-0 rounded-[4px] border px-1.5 py-1 text-xs font-medium uppercase leading-none border-border-medium">JS</span></div><div class="border-border-faint relative mx-3 mb-3 overflow-hidden rounded-[4px] border"><div class="pointer-events-none"><div class="bg-surface-primary h-[260px] w-full overflow-hidden p-3 text-text-secondary whitespace-pre-wrap font-mono text-xs">  /* =========================================================
     SCENE II — THREE CHAPTERS, STRICTLY ONE AFTER ANOTHER
       1. THE BLOOM  — a flower grows and opens (scrubbed)
       2. THE SHOT   — the bow waits under the heart; the scroll
                       holds until the arrow flies; the heart bursts
       3. THE DIVINE TREE — the washes part on a golden tree; the
                       orbit travels in, the year forms, the wish lands
     Nothing overlaps: each chapter is fully gone before the next.
     ========================================================= */
  function corridor() {
    const sec = document.getElementById("corridor");
    const pin = sec.querySelector(".pin");
    const TOTAL = mobile ? 3100 : 3900;   // the whole act, in px
    const GATE = 0.34;                    // scroll fraction where the bow waits
    const TREE = 0.38;                    // where the tree chapter begins

    /* the pin holds the whole act */
    ScrollTrigger.create({
      trigger: sec, start: "top top", end: () =&gt; "+=" + TOTAL,
      pin: pin, anticipatePin: 1
    });

    /* ---- chapter 1 · the bloom ------------------------------------ */
    let flowerOK = false;
    try { flowerOK = !!(window.Flower &amp;&amp; Flower.mount(document.getElementById("bwFlower"))); }
    catch (e) { flowerOK = false; }
    if (flowerOK) {
      Flower.setProgress(0);
      ScrollTrigger.create({
        trigger: sec, start: "top bottom", end: "bottom top",
        onToggle: self =&gt; Flower.setActive(self.isActive)
      });
    }

    /* ---- chapter 3 · the divine tree (lazy mount) ------------------ */
    let treeOK = false, treeTried = false;
    function mountTree() {
      if (treeTried) return treeOK;
      treeTried = true;
      try { treeOK = !!(window.Blossom &amp;&amp; Blossom.mount(document.getElementById("bwCanvas"))); }
      catch (e) { treeOK = false; }
      if (!treeOK) {
        sec.classList.add("no-tree");
        return;
      }
      Blossom.setProgress(0);
      ScrollTrigger.create({
        trigger: sec, start: "top bottom", end: "bottom top",
        onToggle: self =&gt; Blossom.setActive(self.isActive)
      });
      if (!reduce) {
        sec.addEventListener("pointermove", e =&gt; {
          Blossom.setPointer(
            (e.clientX / innerWidth) * 2 - 1,
            (e.clientY / innerHeight) * 2 - 1);
        }, { passive: true });
      }
    }
    mountTree();
    if (!treeOK) {
      // module raced us — try again when it lands, and once more on approach
      sec.classList.remove("no-tree");
      treeTried = false;
      w.addEventListener("blossom:ready", () =&gt; { sec.classList.remove("no-tree"); treeTried = false; mountTree(); }, { once: true });
      ScrollTrigger.create({
        trigger: sec, start: "top bottom+=300", once: true,
        onEnter: () =&gt; { if (!treeOK) { sec.classList.remove("no-tree"); treeTried = false; mountTree(); } }
      });
    }

    /* ---- the gate: chapter 2 waits for the arrow ------------------- */
    let fired = false;
    let holdCleanup = null;

    function skipShot() {
      // reduced motion: no bow — the chapters simply play in order
      fired = true;
      const stage = document.getElementById("bwStage");
      if (stage) gsap.set(stage, { autoAlpha: 0 });
      if (window.__lenis) window.__lenis.start();
    }

    function hold(gateY) {
      if (fired || (w.Shot &amp;&amp; Shot.fired)) return;
      if (window.__lenis) window.__lenis.stop();
      const holdTop = scrollY;
      const offs = [];
      const on = (evt, fn) =&gt; { addEventListener(evt, fn, { passive: true }); offs.push([evt, fn]); };
      let holdAlive = true, to = 0;
      // hands on the string? the fallback politely waits for them
      const take = () =&gt; {
        if (!holdAlive) return;
        if (w.Shot &amp;&amp; Shot.drawing) { to = setTimeout(take, 2500); return; }
        if (w.Shot) Shot.autoFire();
      };
      on("wheel", take);
      // a swipe anywhere but the bow itself is a "just shoot it"
      on("touchmove", e =&gt; {
        const t = e.target;
        if (t &amp;&amp; t.closest &amp;&amp; t.closest("#bwArchery")) return;
        take();
      });
      on("keydown", e =&gt; {
        if (e.key === "ArrowDown" || e.key === "PageDown" || e.key === " ") take();
      });
      on("scroll", () =&gt; { if (scrollY &gt; holdTop + 60) take(); });
      to = setTimeout(take, 9000);
      holdCleanup = () =&gt; {
        holdAlive = false;
        clearTimeout(to);
        offs.forEach(([evt, fn]) =&gt; removeEventListener(evt, fn));
        holdCleanup = null;
      };

      if (reduce) { holdCleanup(); skipShot(); return; }
      // arrived here too fast (scrollbar / stall)? just play the shot for them
      if (typeof gateY === "number" &amp;&amp; scrollY &gt; gateY + 90) {
        holdCleanup();
        if (window.__lenis) window.__lenis.start();
        if (w.Shot) { Shot.enter(); Shot.autoFire(); }
        return;
      }
      if (w.Shot) Shot.enter();
      // cinema mode never waits for a hand
      if (document.getElementById("cinemaHint")) gsap.delayedCall(0.25, take);
    }

    if (w.Shot) {
      Shot.arm({
        onShot() {                     // the arrow is away
          fired = true;
          if (holdCleanup) holdCleanup();
          // the scroll stays held until the washes part (onBloom)
        },
        onBloom() {                    // gold covers the frame — bring the tree in
          if (window.__lenis) {
            window.__lenis.start();
            window.__lenis.scrollTo(scrollY + TOTAL * (TREE - GATE), { duration: 1.6 });
          }
        }
      });
    }

    /* ---- the master timeline: three chapters, in order -------------- */
    const F = { p: 0 }, B = { p: 0 };
    gsap.timeline({
      scrollTrigger: { trigger: sec, start: "top top", end: () =&gt; "+=" + TOTAL, scrub: SCRUB }
    })
      /* chapter 1 — the bloom (0 → 2.8), then it is completely gone */
      .to(F, { p: 1, duration: 2.8, ease: "none",
        onUpdate: () =&gt; { if (flowerOK) Flower.setProgress(F.p); } }, 0)
      .fromTo("#bwFlower", { opacity: 0 }, { opacity: 1, duration: 0.35 }, 0.05)
      .to("#flowerTitle", { opacity: 0, y: -30, filter: "blur(8px)", duration: 0.5, ease: "power1.in" }, 2.05)
      .to("#bwFlower", { opacity: 0, duration: 0.55, ease: "power1.in" }, 2.25)

      /* chapter 2 — one line for the shot (2.9 → 3.4); the gate sits at 3.4 */
      .fromTo("#shotTitle", { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.3 }, 2.9)
      .to("#shotTitle", { opacity: 0, y: -26, filter: "blur(6px)", duration: 0.3, ease: "power1.in" }, 3.1)

      /* chapter 3 — the divine tree (3.8 → 10) */
      .fromTo("#bwCanvas", { opacity: 0 }, { opacity: 1, duration: 0.7 }, 3.8)
      .fromTo("#bwGlow", { opacity: 0 }, { opacity: 0.9, duration: 0.8, ease: "power1.inOut" }, 3.9)
      .to(B, { p: 1, duration: 5.4, ease: "none",
        onUpdate: () =&gt; { if (treeOK) Blossom.setProgress(B.p); } }, 3.8)
      .fromTo("#swKicker", { opacity: 0, y: 14 },
        { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" }, 5.7)
      .fromTo("#swBig", { opacity: 0, y: 26, filter: "blur(10px)" },
        { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.9, ease: "power2.out" }, 5.95)
      .fromTo("#swSub", { opacity: 0, y: 14 },
        { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" }, 6.7)
      /* the goodbye: the wish steps back and the road takes over */
      .to("#bwWish &gt; *", { opacity: 0, y: -20, duration: 0.55, ease: "power1.in", stagger: 0.05 }, 8.9)
      .to("#bwGlow", { opacity: 0.25, duration: 0.8, ease: "none" }, 8.9)
      .to("#bwCanvas", { opacity: 0, duration: 0.6, ease: "none" }, 9.4);

    /* the gate watcher: stop the world at GATE until the arrow flies */
    ScrollTrigger.create({
      trigger: sec, start: "top top", end: () =&gt; "+=" + TOTAL,
      onUpdate: self =&gt; {
        if (reduce) return;
        if (!fired &amp;&amp; !(w.Shot &amp;&amp; Shot.fired) &amp;&amp; self.progress &gt;= GATE) {
          hold(self.start + GATE * TOTAL);
        }
      },
      onLeaveBack: () =&gt; {
        if (holdCleanup) holdCleanup();
        if (window.__lenis) window.__lenis.start();
        if (!fired) return;
        fired = false;
        if (w.Shot) Shot.reset();
        if (flowerOK) Flower.setProgress(0);
        if (treeOK) Blossom.setProgress(0);
      }
    });

    if (reduce) {
      const stage = document.getElementById("bwStage");
      if (stage) gsap.set(stage, { autoAlpha: 0 });
    }

    /* the bloom's title says its line on the way in */
    revealWords(document.getElementById("flowerLine"), sec, { start: "top 70%" });

    /* one clean chime as the wish lands */
    ScrollTrigger.create({
      trigger: sec,
      start: () =&gt; "top+=" + Math.round(TOTAL * 0.62) + " top",
      once: true,
      onEnter: () =&gt; { if (w.BdayAudio &amp;&amp; BdayAudio.wishChime) { try { BdayAudio.wishChime(); } catch (e) {} } }
