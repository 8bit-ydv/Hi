.archery{
  position:absolute;top:0;left:0;
  width:clamp(100px,18vw,168px);
  cursor:grab;-webkit-tap-highlight-color:transparent;
  touch-action:none;will-change:transform;pointer-events:auto
}
.archery:active{cursor:grabbing}
.archery:focus-visible{outline:none}
.archery:focus-visible .bow{filter:drop-shadow(0 0 0 3px rgba(243,201,139,.9)) drop-shadow(0 10px 18px rgba(0,0,0,.6))}
.bow{
