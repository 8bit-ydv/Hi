ght">dipin-birthday-world-v17/js/flower.js</span><span class="text-text-tertiary text-[10px]">223 lines</span></span><button type="button" class="text-text-tertiary hover:text-text-secondary shrink-0 p-0.5 text-[10px]" aria-label="Open file">open</button><svg width="1.5em" height="1.5em" stroke-width="1.5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" color="currentColor" class="text-text-tertiary ml-auto size-3 shrink-0 transition-transform duration-200"><path d="M9 6L15 12L9 18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></div><div role="button" tabindex="0" aria-pressed="false" class="group/artifact relative block w-full overflow-hidden rounded-lg border text-left transition duration-150 bg-surface-secondary border-border-faint shadow-[0px_0px_8px_0_rgba(0,0,0,0.04)] hover:border-border-medium hover:bg-surface-tertiary hover:shadow-none focus-visible:ring-interactive-active focus-visible:ring-offset-surface-primary cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2"><div class="flex items-center gap-1.5 px-3 py-2"><svg width="16" height="16" stroke-width="1.5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" color="currentColor" class="shrink-0 text-text-secondary" aria-hidden="true"><path d="M13.5 6L10 18.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path><path d="M6.5 8.5L3 12L6.5 15.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path><path d="M17.5 8.5L21 12L17.5 15.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path></svg><span class="min-w-0 flex-1 truncate text-sm font-normal text-text-primary">flower.js</span><span class="bg-surface-secondary text-text-tertiary shrink-0 rounded-[4px] border px-1.5 py-1 text-xs font-medium uppercase leading-none border-border-medium">JS</span></div><div class="border-border-faint relative mx-3 mb-3 overflow-hidden rounded-[4px] border"><div class="pointer-events-none"><div class="bg-surface-primary h-[260px] w-full overflow-hidden p-3 text-text-secondary whitespace-pre-wrap font-mono text-xs">/* =============================================================
   THE BLOOM — chapter 1 of scene ii

   A single flower grows and opens on the night: stem, leaves,
   petals, a golden core, floating lights. Scroll-scrubbed (the
   master timeline feeds progress 0→1); a quiet rAF adds the
   living shimmer (light flicker, breathing halo) while visible.

   Structure follows the “Animated Flower” reference (grow →
   unfurl → bloom → lights) rebuilt for the warm pink/gold night.
   ============================================================ */
(function (w) {
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  let canvas = null, ctx = null;
  let W = 0, H = 0, dpr = 1;
  let progress = 0, time = 0, lastT = 0, active = false;
  let cx = 0, cy = 0, R = 80, stemBase = 0;
  const M = { mounted: false };

  const clamp01 = v =&gt; Math.max(0, Math.min(1, v));
  const smooth = t =&gt; t * t * (3 - 2 * t);
  const sstep = (a, b, t) =&gt; smooth(clamp01((t - a) / (b - a)));
  const lerp = (a, b, t) =&gt; a + (b - a) * t;
  const rand = (a, b) =&gt; a + Math.random() * (b - a);

  /* stable decorative randomness (never re-rolled per frame) */
  const lights = Array.from({ length: 9 }, () =&gt; ({
    ang: rand(0, Math.PI * 2), rad: rand(0.25, 0.62),
    sp: rand(0.22, 0.5), ph: rand(0, 6.28), sz: rand(1.4, 3.0)
  }));
  const petalsO = Array.from({ length: 8 }, (_, i) =&gt; ({
    ang: (i / 8) * Math.PI * 2 + rand(-0.07, 0.07),
    len: rand(0.94, 1.08), wid: rand(0.78, 0.95), d: i * 0.028
  }));
  const petalsI = Array.from({ length: 6 }, (_, i) =&gt; ({
    ang: (i / 6) * Math.PI * 2 + 0.45 + rand(-0.07, 0.07),
    len: rand(0.52, 0.62), wid: rand(0.7, 0.85), d: i * 0.022
  }));
  const stemLeaves = [
    { s: 0.34, side: -1, sz: rand(0.85, 1), d: 0.16 },
    { s: 0.58, side: 1, sz: rand(0.9, 1.05), d: 0.24 }
  ];

  function resize() {
    if (!canvas) return;
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = canvas.clientWidth || 1; H = canvas.clientHeight || 1;
    canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    cx = W * 0.5;
    R = Math.max(52, Math.min(W, H) * 0.145);
    cy = H * 0.40;
    stemBase = H * 0.94;
    if (!active) draw();
  }

  /* the stem is a soft S-curve from base to bloom, drawn to a fraction */
  function stemPoint(s) {
    const x0 = cx, y0 = stemBase;
    const x1 = cx - R * 0.34, ym = lerp(stemBase, cy, 0.55);
    const x2 = cx, y2 = cy + R * 0.62;
    const x = (1 - s) * (1 - s) * x0 + 2 * (1 - s) * s * x1 + s * s * x2;
    const y = (1 - s) * (1 - s) * y0 + 2 * (1 - s) * s * ym + s * s * y2;
    return { x, y };
  }

  function drawStem(p) {
    const grow = sstep(0, 0.30, p);
    if (grow &lt;= 0.001) return;
    ctx.save();
    ctx.lineCap = "round";
    const segs = 26, upto = Math.max(1, Math.round(segs * grow));
    // a stem that starts thick and thins toward the bloom
    for (let i = 0; i &lt; upto; i++) {
      const a = stemPoint(i / segs), b = stemPoint((i + 1) / segs);
      const t = i / segs;
      ctx.strokeStyle = `rgba(${Math.round(lerp(150, 190, t))},${Math.round(lerp(112, 145, t))},${Math.round(lerp(78, 104, t))},0.9)`;
      ctx.lineWidth = Math.max(1.4, lerp(R * 0.075, R * 0.028, t));
      ctx.shadowColor = "rgba(255,196,120,.28)";
      ctx.shadowBlur = 8;
      ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
    }
    ctx.restore();
  }

  function drawStemLeaf(p, lf) {
    const grow = sstep(lf.d, lf.d + 0.16, p);
    if (grow &lt;= 0.001) return;
    const at = stemPoint(lf.s);
    const ang = lf.side &lt; 0 ? Math.PI * 0.82 : Math.PI * 0.18;
    const L = R * 0.85 * lf.sz * grow, Wd = R * 0.24 * lf.sz * grow;
    ctx.save();
    ctx.translate(at.x, at.y);
    ctx.rotate(ang + lf.side * (1 - grow) * 0.5);
    const g = ctx.createLinearGradient(0, 0, L, 0);
    g.addColorStop(0, "#b9895a"); g.addColorStop(1, "#e4bd85");
    ctx.fillStyle = g;
    ctx.shadowColor = "rgba(255,206,140,.25)"; ctx.shadowBlur = 7;
    ctx.beginPath();
    ctx.moveTo(0, 0);
    ctx.bezierCurveTo(L * 0.3, -Wd, L * 0.75, -Wd * 0.8, L, 0);
    ctx.bezierCurveTo(L * 0.75, Wd * 0.8, L * 0.3, Wd, 0, 0);
    ctx.fill();
    ctx.restore();
  }

  function drawPetal(ang, open, len, wid, cBase, cTip, glowA) {
    const L = R * len * (0.22 + 0.78 * open);
    const Wd = R * 0.30 * wid * (0.35 + 0.65 * open);
    // closed: everything points up; open: fans out to its own angle
    const a = lerp(-Math.PI / 2 + Math.sin(ang) * 0.15, ang, smooth(open));
    ctx.save();
    ctx.translate(cx, cy);
    ctx.rotate(a);
    const g = ctx.createLinearGradient(0, 0, L, 0);
    g.addColorStop(0, cBase); g.addColorStop(1, cTip);
    ctx.fillStyle = g;
    ctx.shadowColor = `rgba(255,190,140,${0.34 * glowA})`;
    ctx.shadowBlur = 12 * glowA;
    ctx.beginPath();
    ctx.moveTo(0, 0);
    ctx.bezierCurveTo(L * 0.22, -Wd, L * 0.78, -Wd * 0.86, L, -R * 0.02);
    ctx.bezierCurveTo(L * 0.78, Wd * 0.86, L * 0.22, Wd, 0, 0);
    ctx.fill();
    ctx.restore();
  }

  function draw(p, t) {
    ctx.clearRect(0, 0, W, H);

    /* halo behind the bloom breathes with the open progress */
    const open = sstep(0.32, 0.72, p);
    if (open &gt; 0.01) {
      const breathe = reduce ? 1 : 1 + Math.sin(t * 0.9) * 0.04;
      const hr = R * 2.6 * breathe;
      const g = ctx.createRadialGradient(cx, cy, 0, cx, cy, hr);
      g.addColorStop(0, `rgba(255,206,150,${0.20 * open})`);
      g.addColorStop(0.5, `rgba(255,170,130,${0.08 * open})`);
      g.addColorStop(1, "rgba(255,170,130,0)");
      ctx.fillStyle = g;
      ctx.beginPath(); ctx.arc(cx, cy, hr, 0, Math.PI * 2); ctx.fill();
    }

    drawStem(p);
