      float ph = aPhase * 6.2831;
      p.x += sin(uTime * 0.55 + ph + position.y * 0.32) * 0.15;
      p.z += cos(uTime * 0.45 + ph * 0.8) * 0.13;
      p.y += sin(uTime * 0.7 + ph * 1.7) * 0.06;
