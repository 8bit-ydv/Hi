        glowPos.push(c.x + gauss() * 0.8, c.y + gauss() * 0.55, c.z + gauss() * 0.8);
        glowSizes.push(randFloat(1.6, 2.8));
        glowTints.push(Math.random());
        glowPhases.push(Math.random());
      }
