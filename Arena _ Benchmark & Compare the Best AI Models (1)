      const steps = Math.max(2, Math.round(len * 7));
      for (let s = 0; s &lt; steps; s++) {
        const t = s / steps;
        pts.push(new THREE.Vector3(
          x + dx * len * t + randFloat(-.04, .04),
          y + dy * len * t + randFloat(-.04, .04),
          z + dz * len * t + randFloat(-.04, .04)));
      }
