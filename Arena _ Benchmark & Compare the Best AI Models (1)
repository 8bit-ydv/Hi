    canopyGlow = makeCanopyLayer(glowPos, glowSizes, glowTints, glowPhases, true, 0.10, 1);
    scene.add(canopy, canopyGlow);
  }

  /* ---------- the ghost silhouette + canopy from the OBJ ---------- */
  function buildTree(positions, indices) {
    let minY = Infinity, maxY = -Infinity, minX = Infinity, maxX = -Infinity, minZ = Infinity, maxZ = -Infinity;
    for (let i = 0; i &lt; positions.length; i += 3) {
      const x = positions[i], y = positions[i + 1], z = positions[i + 2];
      if (x &lt; minX) minX = x; if (x &gt; maxX) maxX = x;
      if (y &lt; minY) minY = y; if (y &gt; maxY) maxY = y;
      if (z &lt; minZ) minZ = z; if (z &gt; maxZ) maxZ = z;
    }
    const s = TREE_HEIGHT / Math.max(1e-6, maxY - minY);
    const cx = (minX + maxX) / 2, cz = (minZ + maxZ) / 2;
    const map = p =&gt; new THREE.Vector3((p.x - cx) * s, (p.y - minY) * s, (p.z - cz) * s);

    const g = new THREE.BufferGeometry();
    const pos = new Float32Array(positions.length);
    for (let i = 0; i &lt; positions.length; i += 3) {
      const p = map({ x: positions[i], y: positions[i + 1], z: positions[i + 2] });
      pos[i] = p.x; pos[i + 1] = p.y; pos[i + 2] = p.z;
    }
    g.setAttribute("position", new THREE.BufferAttribute(pos, 3));
    g.setIndex(indices);
    treeMesh = new THREE.Mesh(g, new THREE.MeshBasicMaterial({
      color: 0x7a4a3c, transparent: true, opacity: 0.16, depthWrite: false
    }));
    treeMesh.renderOrder = 0;
    scene.add(treeMesh);

    buildCanopyFromCloud(sampleSurface(positions, indices, CANOPY_CLUSTERS * 12), map);
  }

  /* ---------- the petals: a slow, sparse spiral of candle-light ---------- */
  function buildPetals() {
    const r = 5.5;
    const points = [], delay = [], speed = [], color = [];
    const c = new THREE.Color();
    let count = 0;
    while (count &lt; PETAL_PTS) {
      const vec = new THREE.Vector3(randFloat(-r, r), 0, randFloat(-r, r));
      const rRatio = vec.length() / r;
      if (vec.length() &lt;= r &amp;&amp; Math.random() &lt; (1 - rRatio)) {
        points.push(vec);
        c.set(0xfff2d8);
        color.push(c.r, c.g - Math.random() * 0.08, c.b + Math.random() * 0.04);
        delay.push(randFloat(-10, 0));
        let val = randFloat(1, 2) * 0.8;                 // slower rise
        val = Math.random() &lt; 0.25 ? 0 : val;
        speed.push(Math.PI * val * 0.125, val);
        count++;
      }
    }
    const g = new THREE.BufferGeometry().setFromPoints(points);
    g.setAttribute("color", new THREE.Float32BufferAttribute(color, 3));
    g.setAttribute("delay", new THREE.Float32BufferAttribute(delay, 1));
    g.setAttribute("speed", new THREE.Float32BufferAttribute(speed, 2));

    const mat = new THREE.PointsMaterial({ vertexColors: true, size: 0.16, transparent: true, opacity: 1 });
    mat.onBeforeCompile = (shader) =&gt; {
      shader.uniforms.time = uniforms.time;
      shader.uniforms.upperLimit = uniforms.upperLimit;
      shader.uniforms.upperRatio = uniforms.upperRatio;
      shader.uniforms.spiralRadius = uniforms.spiralRadius;
      shader.uniforms.spiralTurns = uniforms.spiralTurns;
      shader.uniforms.tex2026 = uniforms.tex2026;
      shader.uniforms.azimuth = uniforms.azimuth;
      shader.uniforms.uYear = uniforms.uYear;

      shader.vertexShader = `
      uniform float time;
      uniform float upperLimit;
      uniform float upperRatio;
      uniform float spiralRadius;
      uniform float spiralTurns;
      uniform sampler2D tex2026;
      uniform float azimuth;
      uniform float uYear;
      attribute float delay;
      attribute vec2 speed;
      varying float vRatio;
      varying vec2 vSpeed;
      varying float vIsEffect;
      mat2 rot( float a){ return mat2(cos(a), -sin(a), sin(a), cos(a)); }
      ` + shader.vertexShader;
      shader.vertexShader = shader.vertexShader.replace(
        `#include &lt;begin_vertex&gt;`,
        `#include &lt;begin_vertex&gt;
        float t = time + delay;
        t = t &lt; 0. ? 0. : t;
        float h = mod(speed.y * t, upperLimit);
        float hRatio = clamp(h / upperLimit, 0., 1.);
        vRatio = hRatio; vSpeed = speed;
        transformed.y = h;
        float a = atan(position.x, position.z);
        a += speed.x * t;
        float initLength = length(position.xz);
        float finalLength = initLength * upperRatio;
        float ratio = mix(initLength, finalLength, hRatio);
        transformed.x = cos(a) * ratio;
        transformed.z = sin(a) * -ratio;
        float sTurns = sin(time * 0.5) * 0.5 + spiralTurns;
        float spiralA = hRatio * sTurns * PI * 2.;
        float sRadius = mix(spiralRadius, 0., hRatio);
        transformed.x += cos(spiralA) * sRadius;
        transformed.z += sin(spiralA) * -sRadius;
        vec3 efcPos = vec3(0, 6, 0.5);
        vec3 efcClamp = vec3(1., 0.75, 0.25) * 3.5;
        vec3 efcMin = efcPos - efcClamp;
        vec3 efcMax = efcPos + efcClamp;
        vec3 UVTransformed = vec3(transformed);
        UVTransformed.xz *= rot(azimuth);
        vec3 efcUV = (UVTransformed - efcMin) / (efcMax - efcMin);
        float isEffect = texture2D(tex2026, efcUV.xy).r;
        isEffect *= (efcUV.z &gt; 0. &amp;&amp; efcUV.z &lt; 1.) ? 1. : 0.;
        isEffect *= uYear;
        vIsEffect = isEffect;
        `
      );
      shader.vertexShader = shader.vertexShader.replace(
        `gl_PointSize = size;`,
        `bool cond = floor(speed.y + 0.5) == 0.;
        gl_PointSize = size * ( cond ? 0.75 : ((1. - hRatio) * (smoothstep(0., 0.01, hRatio) * 0.25) + 0.75));
        gl_PointSize = mix(gl_PointSize, size * 2.2, isEffect);
        `
      );
      shader.fragmentShader = `
      uniform float time;
      uniform float uReveal;
      varying float vRatio;
      varying vec2 vSpeed;
      varying float vIsEffect;
      mat2 rot( float a){ return mat2(cos(a), -sin(a), sin(a), cos(a)); }
      ` + shader.fragmentShader;
      shader.fragmentShader = shader.fragmentShader.replace(
        `#include &lt;clipping_planes_fragment&gt;`,
        `
        if (vRatio == 1.) discard;
        if (uReveal &lt; 0.01) discard;
        vec2 uv = gl_PointCoord - 0.5;
        float a = (time * vSpeed.x + vSpeed.x) * 10.;
        uv *= rot(a);
        uv.y *= floor(a + 0.5) == 0. ? 1.25 : 2. + sin(a * PI);
        if (length(uv) &gt; 0.5) discard;
        #include &lt;clipping_planes_fragment&gt;`
      );
      shader.fragmentShader = shader.fragmentShader.replace(
        `vec4 diffuseColor = vec4( diffuse, opacity );`,
        `
          vec3 col = vec3(1.0, 0.84, 0.62);
          float d = clamp(uv.x + .5, 0., 1.);
          vec3 base = mix(diffuse, col, pow(d, 2.)) * uReveal * 0.85;
          vec4 diffuseColor = vec4(mix(base, vec3(1.0, 0.82, 0.45), vIsEffect * uReveal), 1.);
        `
      );
    };
    petals = new THREE.Points(g, mat);
    petals.renderOrder = 2;
    scene.add(petals);
  }

  /* ---------- divine light: three soft beams + a halo ---------- */
  function buildRays() {
    rays = new THREE.Group();
    const beamGeo = new THREE.PlaneGeometry(3.2, 26);
    for (let i = 0; i &lt; 3; i++) {
      const mat = new THREE.ShaderMaterial({
        transparent: true, depthWrite: false, side: THREE.DoubleSide,
        blending: THREE.AdditiveBlending,
        uniforms: { uTime: uTimeCanopy, uOn: { value: 0 }, uSeed: { value: i * 2.13 } },
        vertexShader: `varying vec2 vUv; void main(){ vUv = uv; gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); }`,
        fragmentShader: `
          uniform float uTime; uniform float uSeed; uniform float uOn; varying vec2 vUv;
          void main(){
            float vert = pow(vUv.y, 2.0);
            float horiz = smoothstep(0.0, 0.5, vUv.x) * smoothstep(1.0, 0.5, vUv.x);
            float pulse = 0.62 + 0.38 * sin(uTime * 0.32 + uSeed);
            float a = vert * horiz * pulse * uOn * 0.14;
            gl_FragColor = vec4(1.0, 0.89, 0.64, a);
          }`
      });
      rayMats.push(mat);
      const m = new THREE.Mesh(beamGeo, mat);
      const az = i * 2.2 + 0.7;
      m.position.set(Math.sin(az) * 2.0, 13.2, Math.cos(az) * 2.0);
      m.rotation.y = az + Math.PI / 2;
      m.rotation.z = (i - 1) * 0.045;
      m.renderOrder = 4;
      rays.add(m);
    }
    scene.add(rays);

    const haloMat = new THREE.ShaderMaterial({
      transparent: true, depthWrite: false, blending: THREE.AdditiveBlending,
      uniforms: { uOn: { value: 0 }, uTime: uTimeCanopy, uSeed: { value: 9.4 } },
      vertexShader: `varying vec2 vUv; void main(){ vUv = uv; gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); }`,
      fragmentShader: `
        uniform float uOn; uniform float uTime; uniform float uSeed; varying vec2 vUv;
        void main(){
          float d = length(vUv - 0.5) * 2.0;
          float pulse = 0.72 + 0.28 * sin(uTime * 0.4 + uSeed);
          float a = smoothstep(1.0, 0.05, d) * uOn * 0.30 * pulse;
          gl_FragColor = vec4(1.0, 0.9, 0.68, a);
        }`
    });
    rayMats.push(haloMat);
    halo = new THREE.Mesh(new THREE.PlaneGeometry(34, 34), haloMat);
    halo.position.set(0, 12.5, 0);
    halo.renderOrder = 4;
    scene.add(halo);
  }

  /* ---------- the ground: a warm pool under the tree ---------- */
  function buildBase() {
    const geom = new THREE.CircleGeometry(7.5, 64);
    geom.rotateX(-Math.PI * 0.5);
    const mat = new THREE.MeshBasicMaterial({ color: 0x6b4a52 });
    mat.defines = { "USE_UV": "" };
    mat.onBeforeCompile = (shader) =&gt; {
      shader.fragmentShader = shader.fragmentShader.replace(
        `#include &lt;opaque_fragment&gt;`,
        `
          vec3 col = vec3(0.075, 0.05, 0.10);
          vec2 uv = vUv - 0.5;
          uv *= 2.;
          col = mix(outgoingLight, col, length(uv));
          gl_FragColor = vec4(col, diffuseColor.a);
        `
      );
    };
    base = new THREE.Mesh(geom, mat);
    base.position.y = -0.02;
    scene.add(base);
  }

  /* ---------- camera: scroll drives the orbit ----------
     The WHOLE tree stays in frame the entire time (16-unit tree,
     55° fov → lens stays ≥ ~16 units out, look-point at mid-tree). */
  function updateCamera() {
    const p = smooth(clamp01(M.progress));
    const drift = reduce ? 0 : clockT * 0.04;
    const az = lerp(-2.4, 0.95, p) + drift + ptr.x * 0.25;
    let radius = lerp(18.5, 15.6, p);
    if (camera.aspect &lt; 0.75) radius *= 1.16;
    const h = lerp(5.2, 6.8, p) + ptr.y * 0.7;
    camera.position.set(Math.sin(az) * radius, h, Math.cos(az) * radius);
    camera.lookAt(0, lerp(7.4, 7.9, p), 0);
    if (halo) halo.quaternion.copy(camera.quaternion);
    uniforms.azimuth.value = az;
  }

  function renderFrame(dt) {
    clockT += dt * (reduce ? 0.18 : 0.5);
    uTimeCanopy.value = clockT;
    uniformsTree.time.value = clockT * 5;
    uniforms.time.value = clockT;
    ptr.x += (ptr.tx - ptr.x) * 0.05;
    ptr.y += (ptr.ty - ptr.y) * 0.05;
    updateCamera();
    renderer.render(scene, camera);
  }

  function loop(now) {
    requestAnimationFrame(loop);
    if (!M.active || !M.ready || !renderer) return;
    const dt = lastFrame ? Math.min((now - lastFrame) / 1000, 0.05) : 0.016;
    lastFrame = now;
    renderFrame(dt);
  }

  /* ---------- public API ---------- */
  function mount(el) {
    if (M.failed) return false;
    if (M.mounted) return true;
    canvas = el;
    if (!canvas) return false;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
      renderer.setClearColor(0x000000, 0);
    } catch (e) {
      console.warn("[blossom] WebGL unavailable:", e);
      M.failed = true;
      return false;
    }
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, mobile ? 1.5 : 1.75));
    scene = new THREE.Scene();
    camera = new THREE.PerspectiveCamera(55, 1, 0.1, 100);
    camera.position.set(0, 5, 10);

    uniforms.tex2026.value = makeYearTexture();
    buildBase();
    buildPetals();
    buildRays();

    fetch("assets/models/tree.obj")
      .then(r =&gt; { if (!r.ok) throw new Error("tree.obj " + r.status); return r.text(); })
      .then(txt =&gt; {
        const { positions, indices } = parseOBJ(txt);
        buildTree(positions, indices);
      })
      .catch(() =&gt; {
        // procedural fallback: normalise the cloud, then cluster it
        const cloud = proceduralTree(CANOPY_CLUSTERS * 30);
        let minY = Infinity, maxY = -Infinity;
        cloud.forEach(p =&gt; { if (p.y &lt; minY) minY = p.y; if (p.y &gt; maxY) maxY = p.y; });
        const s = TREE_HEIGHT / Math.max(1e-6, maxY - minY);
        buildCanopyFromCloud(cloud, p =&gt; new THREE.Vector3(p.x * s, (p.y - minY) * s, p.z * s));
      })
      .then(() =&gt; {
        M.ready = true;
        resize();
        renderFrame(0.016);
      });

    window.addEventListener("resize", () =&gt; { if (M.mounted) resize(); }, { passive: true });
    M.mounted = true;
    requestAnimationFrame(loop);
    return true;
  }

  function setProgress(p) {
    M.progress = clamp01(p);
    const pr = smooth(M.progress);
    uniforms.uReveal.value = smooth(clamp01((M.progress - 0.04) / 0.24));
    uniforms.uYear.value = smooth(clamp01((M.progress - 0.40) / 0.18));
    uRevealCanopy.value = smooth(clamp01((M.progress - 0.02) / 0.20));
    const raysOn = smooth(clamp01((M.progress - 0.06) / 0.22));
    rayMats.forEach(m =&gt; { m.uniforms.uOn.value = raysOn; });
  }

  function setActive(b) { M.active = !!b; if (b) lastFrame = 0; }
  function setPointer(x, y) { ptr.tx = x; ptr.ty = y; }
  function resize() {
    if (!renderer || !canvas) return;
    const wd = canvas.clientWidth || 1, ht = canvas.clientHeight || 1;
    renderer.setSize(wd, ht, false);
    camera.aspect = wd / ht;
    camera.updateProjectionMatrix();
  }

  w.Blossom = {
    mount, setProgress, setActive, setPointer, resize,
    get ready() { return M.ready; },
    get failed() { return M.failed; },
    get stats() {
      let frame = null;
      if (camera &amp;&amp; treeMesh) {
        const a = new THREE.Vector3(0, 0, 0).project(camera);
        const b = new THREE.Vector3(0, TREE_HEIGHT, 0).project(camera);
        frame = {
          topY: +b.y.toFixed(3), bottomY: +a.y.toFixed(3),
          coverage: +(Math.abs(b.y - a.y) / 2).toFixed(3),
          inFrame: b.y &lt;= 1 &amp;&amp; a.y &gt;= -1 &amp;&amp; Math.abs(b.x) &lt;= 1
        };
      }
      return {
        canopy: canopy ? canopy.geometry.attributes.position.count : 0,
        petals: petals ? petals.geometry.attributes.position.count : 0,
        progress: +M.progress.toFixed(3),
        frame
      };
    }
  };
  try { w.dispatchEvent(new Event("blossom:ready")); } catch (e) {}
})(window);
