    const p = new THREE.Vector3();
    for (let i = 0; i &lt; count; i++) {
      const r = Math.random() * total;
      let lo = 0, hi = tri - 1;
      while (lo &lt; hi) { const mid = (lo + hi) &gt;&gt; 1; if (cdf[mid] &lt; r) lo = mid + 1; else hi = mid; }
