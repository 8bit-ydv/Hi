  function buildCanopyFromCloud(cloudPts, normalise) {
    // cluster centres: spread points from the upper half of the tree
    const up = cloudPts.map(normalise).filter(p =&gt; p.y &gt; TREE_HEIGHT * 0.42);
    const pool = up.length &gt; 12 ? up : cloudPts.map(normalise);
    const centres = [];
    let guard = 0;
    while (centres.length &lt; CANOPY_CLUSTERS &amp;&amp; guard++ &lt; 600) {
