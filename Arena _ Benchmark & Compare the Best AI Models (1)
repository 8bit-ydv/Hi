  let treeMesh = null, canopy = null, canopyGlow = null, petals = null;
  let rays = null, halo = null, base = null;

  const uTimeCanopy = { value: 0 };
  const uRevealCanopy = { value: 0 };
  const uniformsTree = { time: { value: 0 } };
  const uniforms = {
    time: { value: 0 },
    upperLimit: { value: 12 },
    upperRatio: { value: 1.25 },
    spiralRadius: { value: 1 },
    spiralTurns: { value: 1 },
    tex2026: { value: null },
    azimuth: { value: 0 },
    uReveal: { value: 0 },
    uYear: { value: 0 }
